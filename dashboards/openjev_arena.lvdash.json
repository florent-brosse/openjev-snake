{
 "datasets": [
  {
   "name": "ds_decisions",
   "displayName": "OpenJev decisions",
   "queryLines": [
    "SELECT ts, date_trunc('MINUTE', ts) AS minute, game_id, mode, snake_id,\n",
    "  CASE WHEN persona IN ('viper','turtle','glutton') THEN initcap(persona) ELSE 'Custom' END AS persona_label,\n",
    "  split(choice, '_')[0] AS intent_kind, choice, confidence, entropy_nats, danger, outlook_score, latency_ms, input_tokens,\n",
    "  CASE WHEN order_text IS NOT NULL AND trim(order_text) <> '' THEN 'With commander order' ELSE 'No order' END AS order_status\n",
    "FROM decisions WHERE brain = 'openjev'\n"
   ]
  },
  {
   "name": "ds_players",
   "displayName": "Players per match",
   "queryLines": [
    "SELECT game_id, mode, ended_at, p.snake_id, p.name, p.kind, p.brain, p.score, p.kills, p.deaths,\n",
    "  CASE WHEN winner = p.snake_id THEN 1.0 ELSE 0.0 END AS win,\n",
    "  CASE WHEN p.kind = 'human' THEN 'You (human)'\n",
    "       WHEN p.persona IN ('viper','turtle','glutton') THEN concat(initcap(p.persona), ' \u00b7 ', p.brain)\n",
    "       ELSE concat('Custom \u00b7 ', p.brain) END AS player_label\n",
    "FROM (SELECT *, explode(players) AS p FROM games)\n"
   ]
  },
  {
   "name": "ds_kpi",
   "displayName": "Latency KPIs",
   "queryLines": [
    "SELECT percentile(latency_ms, 0.5) AS latency_p50, percentile(latency_ms, 0.9) AS latency_p90, count(*) AS decisions\n",
    "FROM decisions WHERE brain = 'openjev' AND latency_ms IS NOT NULL\n"
   ]
  },
  {
   "name": "ds_danger",
   "displayName": "Danger vs deaths",
   "queryLines": [
    "WITH d AS (\n",
    "  SELECT game_id, snake_id, tick, danger FROM decisions\n",
    "  WHERE brain = 'openjev' AND danger IS NOT NULL),\n",
    "deaths AS (SELECT DISTINCT game_id, snake_id, tick AS death_tick FROM events WHERE type = 'death'),\n",
    "labeled AS (\n",
    "  SELECT d.game_id, d.snake_id, d.tick, d.danger, max(CASE WHEN x.death_tick IS NOT NULL THEN 1.0 ELSE 0.0 END) AS died_2s\n",
    "  FROM d LEFT JOIN deaths x ON x.game_id = d.game_id AND x.snake_id = d.snake_id AND x.death_tick BETWEEN d.tick AND d.tick + 16\n",
    "  GROUP BY 1, 2, 3, 4)\n",
    "SELECT concat(cast(least(floor(danger * 5), 4) * 20 AS INT), '-', cast(least(floor(danger * 5), 4) * 20 + 20 AS INT), '%') AS danger_band,\n",
    "  count(*) AS decisions, avg(died_2s) AS death_rate\n",
    "FROM labeled GROUP BY 1 ORDER BY 1\n"
   ]
  },
  {
   "name": "ds_uncertain",
   "displayName": "Most uncertain decisions",
   "queryLines": [
    "SELECT ts, mode, CASE WHEN persona IN ('viper','turtle','glutton') THEN initcap(persona) ELSE 'Custom' END AS persona_label,\n",
    "  order_text, choice, round(confidence, 2) AS confidence, round(entropy_nats, 2) AS entropy_nats,\n",
    "  concat_ws(' | ', transform(slice(candidates, 1, 3), c -> concat(c.id, ' ', cast(round(c.probability * 100) AS INT), '%'))) AS top_options\n",
    "FROM decisions WHERE brain = 'openjev'\n",
    "ORDER BY entropy_nats DESC LIMIT 25\n"
   ]
  }
 ],
