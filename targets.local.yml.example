# Copy to targets.local.yml (git-ignored) to pin your own workspace / catalog / warehouse.
# Deploy with: databricks bundle deploy -t mine -p <your-cli-profile>
targets:
  mine:
    workspace:
      host: https://<your-workspace>.cloud.databricks.com
    variables:
      catalog: <your_catalog>
      # warehouse_id: <warehouse id>   # optional: defaults to the "Serverless Starter Warehouse"
